# FlavorGraphTraverser Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# OpenRouter API Key (required for full benchmark)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Override default ollama host
# OLLAMA_HOST=http://localhost:11434

# Optional: Override data paths
# FLAVOR_GRAPH_FILE=data/graphs/coffee_flavor_wheel.pkl
# FLAVOR_QUESTIONS_FILE=data/questions/benchmark_questions.json

# Optional: Override output directory
# RESULTS_DIR=results
# LOGS_DIR=logs
